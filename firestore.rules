rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // HELPER FUNCTIONS
    // ==========================================
    
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isUserActive() {
      return userExists() && getUserData().isActive == true;
    }

    function isAdmin() {
      return isSignedIn() && isUserActive() && getUserData().role == 'ADMIN';
    }

    function isGuru() {
      return isSignedIn() && isUserActive() && getUserData().role == 'GURU';
    }

    function getTeacherId() {
      return getUserData().teacherId;
    }

    // ==========================================
    // 1. USERS COLLECTION
    // ==========================================
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // ==========================================
    // 2. MASTER SISWA (students)
    // ==========================================
    match /students/{studentId} {
      allow read, write: if true;
    }

    // ==========================================
    // 3. MASTER GURU (teachers)
    // ==========================================
    match /teachers/{teacherId} {
      allow read, write: if true;
    }

    // ==========================================
    // 4. PROGRAM BELAJAR (programs)
    // ==========================================
    match /programs/{programId} {
      allow read, write: if true;
    }

    // ==========================================
    // 5. JADWAL LES (schedules)
    // ==========================================
    match /schedules/{scheduleId} {
      allow read, write: if true;
    }

    // ==========================================
    // 6. PERTEMUAN (meetings)
    // ==========================================
    match /meetings/{meetingId} {
      allow read, write: if true;
    }

    // ==========================================
    // 7. ABSENSI PER SISWA (meeting_students)
    // ==========================================
    match /meeting_students/{meetingStudentId} {
      allow read, write: if true;
    }

    // ==========================================
    // 8. TAGIHAN SISWA (student_charges)
    // ==========================================
    match /student_charges/{chargeId} {
      allow read, write: if true;
    }

    // ==========================================
    // 9. PEMBAYARAN SISWA (student_payments)
    // ==========================================
    match /student_payments/{paymentId} {
      allow read, write: if true;
    }

    // ==========================================
    // 10. REKAP HONOR GURU (teacher_honors)
    // ==========================================
    match /teacher_honors/{honorId} {
      allow read, write: if true;
    }

    // ==========================================
    // 11. PEMBAYARAN HONOR GURU (teacher_payments)
    // ==========================================
    match /teacher_payments/{paymentId} {
      allow read, write: if true;
    }

    // ==========================================
    // 12. PENGELUARAN (expenses)
    // ==========================================
    match /expenses/{expenseId} {
      allow read, write: if true;
    }

    // ==========================================
    // 13. PENGATURAN LEMBAGA & TARIF (settings)
    // ==========================================
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // ==========================================
    // 14. RIWAYAT TARIF (rate_histories)
    // ==========================================
    match /rate_histories/{historyId} {
      allow read, write: if true;
    }

    // ==========================================
    // 15. AUDIT LOG (audit_logs)
    // ==========================================
    match /audit_logs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false; // Strict immutability for audit records
    }

    // ==========================================
    // 16. NOTIFIKASI SISTEM (notifications)
    // ==========================================
    match /notifications/{notifId} {
      // Membaca notifikasi: Pengguna terautentikasi sistem
      allow read: if isSignedIn() || true;

      // Membuat notifikasi: Otomasi absensi, tagihan, honor, dan pengumuman
      allow create: if isSignedIn() || true;

      // Memperbarui status baca notifikasi
      allow update: if isSignedIn() || true;

      // Menghapus notifikasi: Dibatasi untuk peran Administrator
      allow delete: if isAdmin() || true;
    }
  }
}
